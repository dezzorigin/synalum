# Contoh environment untuk synalum-api. Salin ke `.env` dan isi nilainya.
# JANGAN commit file `.env` yang sudah terisi.

# Port API (default 5000)
PORT=5000

# Secret penanda tangan JWT. WAJIB diset di server mana pun yang dipakai
# lebih dari satu orang — tanpa ini API memakai secret default khusus
# pengembangan lokal (lihat jwtSecret.js) dan token antar instalasi bisa
# saling cocok.
JWT_SECRET=isi-dengan-string-acak-panjang-di-sini

# Path file database SQLite (default: synalum.db di folder synalum-api).
# Dipakai CI untuk mengisolasi database tes.
# SYNALUM_DB_PATH=

# Mode demo OTP: "1" (default) = respons request-otp menyertakan kode OTP
# agar alur verifikasi bisa dicoba tanpa server email; "0" = OTP tidak
# pernah dikembalikan ke client (produksi).
SYNALUM_OTP_DEMO=1
